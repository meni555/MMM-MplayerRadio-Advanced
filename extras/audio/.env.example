# MagicMirror (MMM-Remote-Control) on this host: stop the radio and show what is playing
MM_URL=http://127.0.0.1:8080
# apiKey of MMM-Remote-Control
MM_TOKEN=

# ---- Spotify (Spotify Soloist, official headless client) ----
# Create the key at https://developer.spotify.com/dashboard/soloist (Premium needed once for setup).
# Without SOLOIST_API_KEY a key stored in ./spotify-data via `soloist setup-api-key` is used.
SOLOIST_API_KEY=
SPOTIFY_NAME=MagicMirror
# Optional PipeWire node name or ID (`wpctl status`); empty = default output
SPOTIFY_AUDIO_DEVICE=
SPOTIFY_INITIAL_VOLUME=60
# 1 = verbose Soloist log (only for troubleshooting, never prints the API key)
SPOTIFY_VERBOSE=0

# ---- YouTube / YouTube Music cast ----
# Name in the YouTube / YouTube Music app
YTCAST_NAME=MagicMirror
# Audio output for mpv. With PipeWire/PulseAudio (required by Soloist) use pulse.
AUDIO_DEVICE=pulse
# ALSA card for the old "is the sound card free?" check. Empty = skip it (Pulse/PipeWire mode).
ALSA_CARD=
# Network interfaces the cast target is announced on (no Docker bridges)
DIAL_INTERFACES=wlan0,eth0
# Bridge API (Spotify) and go-librespot-compatible endpoint used by ytcast/magicmirror-control
SPOTIFY_API=http://127.0.0.1:3678

# ---- host audio session ----
# UID of the user whose PipeWire/PulseAudio session the containers use (`id -u`)
PUID=1000
# GID of the host audio group (`getent group audio | cut -d: -f3`)
AUDIO_GID=29
